# Salin file ini menjadi .env lalu isi nilainya.
# Ambil dari: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...   # anon public key (AMAN untuk browser)

# ID baris di tabel public.projects yang dipakai aplikasi.
# Kosongkan untuk memilih project lewat UI (listMyProjects).
VITE_SUPABASE_PROJECT_ID=
